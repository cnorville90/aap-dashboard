---
clusters:
  - protocol: https
    address: {{ aap_gateway_fqdn }}
    port: 443
    access_token: {{ oauth_access_token }}
    refresh_token: {{ oauth_refresh_token }}
    client_id: {{ oauth_client_id }}
    client_secret: {{ oauth_client_secret }}
    verify_ssl: {{ verify_ssl | lower }}
    sync_schedules:
      - name: {{ sync_schedule_name }}
        rrule: {{ sync_schedule_rrule }}
        enabled: {{ sync_schedule_enabled | lower }}
